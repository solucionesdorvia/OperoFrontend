{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --legacy-peer-deps && npx --yes expo export --platform web"
  },
  "deploy": {
    "startCommand": "npx --yes serve dist -s -l $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}
